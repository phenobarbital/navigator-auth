# ---------------------------------------------------------------------------
# Settings for examples/identity_vault_server.py
#
# Copy the parts you need into env/dev/.env (navconfig reads that file at
# import time). Every external backend is optional: the example enables one
# only when its client id is present, so you can start with just GitHub.
# ---------------------------------------------------------------------------

# --- PostgreSQL (required: linked identities live in auth.user_identities) --
DBHOST=localhost
DBPORT=5432
DBNAME=navigator
DBUSER=navigator
DBPWD=changeme

# --- Redis (required: sessions + per-flow OAuth2 state) --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# --- Identity Vault encryption (required to store credentials) -------------
# 32 random bytes, base64. Generate with:
#   python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Keep it: rotating it makes already-stored credentials unreadable.
VAULT_MASTER_KEY_v1=
VAULT_ACTIVE_KEY_ID=1

# --- Identity Vault behaviour (optional, defaults shown) -------------------
IDENTITY_LINK_TTL=600         # seconds a pending link flow stays valid
IDENTITY_CACHE_TTL=3600       # session-vault cache TTL
IDENTITY_REFRESH_LEEWAY=120   # refresh when expiring within N seconds

# --- Microsoft Azure -------------------------------------------------------
# Register an app in Entra ID; redirect URI (Web):
#   http://localhost:5000/auth/azure/callback/
AZURE_ADFS_CLIENT_ID=
AZURE_ADFS_CLIENT_SECRET=
AZURE_ADFS_TENANT_ID=common
AZURE_ADFS_SCOPES=User.Read
AZURE_IDENTITY_SCOPES=User.Read

# --- GitHub ----------------------------------------------------------------
# OAuth app callback URL: http://localhost:5000/auth/github/callback/
# Note: classic OAuth apps issue no refresh token (the vault shows
# "no refresh" and PUT answers 409 — re-link instead). GitHub *Apps* with
# expiring user tokens do issue one.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPES=user:email
GITHUB_IDENTITY_SCOPES=read:user,user:email

# --- Odoo (OCA oauth_provider addon) --------------------------------------
# Redirect URI in the Odoo client: http://localhost:5000/auth/odoo/callback/
ODOO_DOMAIN=
ODOO_CLIENT_ID=
ODOO_CLIENT_SECRET=
ODOO_AUTHORIZE_PATH=/oauth2/auth
ODOO_TOKEN_PATH=/oauth2/token
ODOO_USERINFO_PATH=/oauth2/userinfo
ODOO_SCOPES=profile,email
ODOO_IDENTITY_SCOPES=profile,email

# --- Google / Okta (optional, same pattern) --------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OKTA_CLIENT_ID=
# OKTA_CLIENT_SECRET=
# OKTA_DOMAIN=
